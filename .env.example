# DEMO: no API key needed; deterministic, no real LLM reasoning
RESEARCH_MODEL_BACKEND=mock
RESEARCH_SEARCH_BACKEND=none
RESEARCH_DATA_DIR=./data
RESEARCH_MAX_ROUNDS=2
RESEARCH_MIN_EVIDENCE=2
RESEARCH_MAX_SOURCES=10
RESEARCH_RETRIEVAL_BACKEND=lexical
RESEARCH_STEP_TIMEOUT_SECONDS=30
